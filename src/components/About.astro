---
import type { AboutContent } from '../types/site';

interface Props {
	content: AboutContent;
}

const { content } = Astro.props;
---

<section id="sobre-mi" class="about" aria-labelledby="about-title">
	<div class="container">
		<p class="about__eyebrow">{content.eyebrow}</p>

		<div class="about__grid">
			<article class="about__main-card" data-spotlight>
				<div class="about__main-content">
					<h2 id="about-title">{content.title}</h2>
					<div class="about__copy">
						{content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
					</div>
				</div>
			</article>

			<dl class="about__details">
				{content.details.map((detail) => (
					<div class:list={['about-card', `about-card--${detail.kind}`]} data-spotlight>
						<dt>{detail.label}</dt>
						<dd>
							<strong>{detail.primary}</strong>
							<span>{detail.secondary}</span>
						</dd>
					</div>
				))}
			</dl>
		</div>
	</div>
</section>

<script>
	import { setupSpotlights } from '../scripts/spotlight';

	setupSpotlights();
</script>

<style>
	.about {
		padding-block: var(--section-space);
		border-top: 1px solid var(--color-border);
	}

	.about__eyebrow {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin: 0 0 var(--space-8);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.about__eyebrow::after {
		width: 3rem;
		height: 1px;
		background: var(--color-border-strong);
		content: '';
	}

	.about__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(22rem, 0.9fr);
		gap: var(--space-4);
	}

	.about__main-card,
	.about-card {
		--spotlight-x: 50%;
		--spotlight-y: 50%;

		position: relative;
		isolation: isolate;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}

	.about__main-card {
		display: flex;
		min-height: 33rem;
		box-shadow: var(--shadow-soft);
	}

	[data-spotlight]::before,
	[data-spotlight]::after {
		position: absolute;
		content: '';
		opacity: 0;
		pointer-events: none;
		transition: opacity 320ms var(--ease-out);
	}

	[data-spotlight]::before {
		z-index: -1;
		inset: 0;
		background: radial-gradient(
			30rem circle at var(--spotlight-x) var(--spotlight-y),
			rgb(var(--color-spotlight-rgb) / 12%),
			transparent 68%
		);
	}

	[data-spotlight]::after {
		z-index: 2;
		inset: -1px;
		padding: 1px;
		border-radius: inherit;
		background: radial-gradient(
			15rem circle at var(--spotlight-x) var(--spotlight-y),
			rgb(255 255 255 / 50%),
			rgb(var(--color-spotlight-rgb) / 20%) 38%,
			transparent 72%
		);
		-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
	}

	[data-spotlight][data-spotlight-active]::before,
	[data-spotlight][data-spotlight-active]::after {
		opacity: 1;
	}

	.about__main-content {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-16);
		padding: clamp(2rem, 5vw, 4.5rem);
	}

	h2 {
		max-width: 12ch;
		margin: 0;
		font-size: clamp(2.35rem, 4.8vw, 4.7rem);
		font-weight: 520;
		letter-spacing: -0.055em;
		line-height: 1;
		text-wrap: balance;
	}

	.about__copy {
		max-width: 44rem;
	}

	.about__copy p {
		margin: 0;
		color: #c5c5c2;
		font-size: clamp(1rem, 1.35vw, 1.16rem);
		line-height: 1.7;
	}

	.about__copy p + p {
		margin-top: var(--space-4);
	}

	.about__details {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		grid-template-rows: repeat(2, minmax(0, 1fr));
		gap: var(--space-4);
		margin: 0;
	}

	.about-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-8);
		padding: clamp(1.35rem, 2.5vw, 2rem);
		transition: border-color var(--duration-base) var(--ease-out), background-color var(--duration-base) var(--ease-out);
	}

	.about-card:hover {
		border-color: var(--color-border-strong);
		background-color: var(--color-surface-step);
	}

	.about-card--education,
	.about-card--location {
		grid-column: span 3;
	}

	.about-card--focus {
		grid-column: span 2;
	}

	.about-card--quality {
		grid-column: span 4;
	}

	.about-card dt {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.about-card dd {
		margin: 0;
	}

	.about-card strong,
	.about-card span {
		display: block;
	}

	.about-card strong {
		font-size: clamp(1.2rem, 2vw, 1.65rem);
		font-weight: 540;
		letter-spacing: -0.035em;
		line-height: 1.15;
	}

	.about-card span {
		margin-top: var(--space-3);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		line-height: 1.5;
	}

	.about-card--quality strong {
		font-size: clamp(1rem, 1.45vw, 1.25rem);
		line-height: 1.4;
	}

	@media (max-width: 64rem) {
		.about__grid {
			grid-template-columns: 1fr;
		}

		.about__main-card {
			min-height: 29rem;
		}

		.about__details {
			grid-template-rows: none;
		}

		.about-card {
			min-height: 12rem;
		}
	}

	@media (max-width: 42rem) {
		.about__grid,
		.about__details {
			gap: var(--space-3);
		}

		.about__main-card {
			min-height: 0;
		}

		.about__main-content {
			gap: var(--space-12);
			padding: clamp(1.5rem, 7vw, 2.25rem);
		}

		.about__details {
			grid-template-columns: 1fr;
		}

		.about-card--education,
		.about-card--location,
		.about-card--focus,
		.about-card--quality {
			grid-column: auto;
		}

		.about-card {
			min-height: 10rem;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.about-card:hover {
			border-color: var(--color-border);
			background-color: var(--color-surface);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		[data-spotlight]::before,
		[data-spotlight]::after {
			display: none;
		}
	}
</style>
