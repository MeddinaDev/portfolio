---
import { Image } from 'astro:assets';
import portrait from '../assets/images/javier-medina-professional.jpeg';
import type { HeroContent } from '../types/site';
import BackendFlow from './BackendFlow.astro';

interface Props {
	content: HeroContent;
}

const { content } = Astro.props;
const [github, linkedIn] = content.socialLinks;
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__inner container">
		<div class="hero__copy">
			<p class="hero__eyebrow">
				<span class="hero__portrait-frame">
					<Image
						class="hero__portrait"
						src={portrait}
						alt="Retrato de Javier Medina"
						width={144}
						loading="eager"
						decoding="async"
					/>
				</span>
				<span>{content.eyebrow}</span>
			</p>
			<h1 id="hero-title">{content.title}</h1>
			<p class="hero__stack">{content.stack}</p>
			<p class="hero__description">{content.description}</p>

			<div class="hero__actions" aria-label="Enlaces destacados">
				<a class="button button--primary" href={content.projectsHref}>{content.projectsLabel}</a>
				<a class="button button--secondary" href={github.href} target="_blank" rel="noopener noreferrer">
					{github.label}<span class="sr-only"> (se abre en una pestaña nueva)</span>
				</a>
				<a class="button button--secondary" href={linkedIn.href} target="_blank" rel="noopener noreferrer">
					{linkedIn.label}<span class="sr-only"> (se abre en una pestaña nueva)</span>
				</a>
			</div>

			<ul class="hero__metadata" aria-label="Información profesional">
				<li>{content.location}</li>
				<li>{content.availability}</li>
			</ul>
		</div>

		<div class="hero__visual">
			<BackendFlow />
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
	}

	.hero::before {
		position: absolute;
		z-index: -1;
		top: -18rem;
		left: -16rem;
		width: 40rem;
		height: 40rem;
		border: 1px solid rgb(var(--color-hero-decoration-rgb) / 18%);
		border-radius: 50%;
		box-shadow: 0 0 0 8rem rgb(var(--color-hero-decoration-rgb) / 10%), 0 0 0 16rem rgb(var(--color-hero-decoration-rgb) / 7%);
		content: '';
	}

	.hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.03fr) minmax(22rem, 0.8fr);
		align-items: center;
		gap: clamp(3rem, 8vw, 7rem);
		padding-block: var(--space-8) clamp(5.5rem, 13vh, 9rem);
	}

	.hero__copy {
		max-width: 42rem;
	}

	.hero__eyebrow {
		display: flex;
		min-height: 7rem;
		align-items: center;
		gap: var(--space-3);
		margin: 0 0 var(--space-8);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.hero__portrait-frame {
		display: block;
		flex: none;
		order: -1;
		width: 7rem;
		height: 7rem;
		overflow: hidden;
		border: 1px solid var(--color-border-strong);
		border-radius: 50%;
	}

	.hero__portrait {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 20%;
	}

	.hero__eyebrow::before {
		width: 1.75rem;
		height: 1px;
		background: var(--color-border-strong);
		content: '';
	}

	h1 {
		max-width: 12ch;
		margin: 0;
		font-size: clamp(2.85rem, 6.2vw, 5.75rem);
		font-weight: 540;
		letter-spacing: -0.065em;
		line-height: 0.96;
		text-wrap: balance;
	}

	.hero__stack {
		margin: var(--space-6) 0 0;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: clamp(0.72rem, 1.2vw, 0.86rem);
		letter-spacing: 0.045em;
	}

	.hero__description {
		max-width: 35rem;
		margin: var(--space-8) 0 0;
		color: #c5c5c2;
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
		line-height: 1.55;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.button {
		display: inline-flex;
		min-height: 2.9rem;
		align-items: center;
		justify-content: center;
		padding: 0.72rem 1.1rem;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition: background var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
	}

	.button--primary {
		border-color: var(--color-text);
		background: var(--color-text);
		color: var(--color-canvas);
	}

	.button--primary:hover,
	.button--primary:focus-visible {
		transform: translateY(-2px);
		background: transparent;
		color: var(--color-text);
	}

	.button--secondary:hover,
	.button--secondary:focus-visible {
		border-color: var(--color-text);
		background: var(--color-surface-raised);
	}

	.hero__metadata {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-8);
		padding: var(--space-8) 0 0;
		margin: var(--space-8) 0 0;
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.67rem;
		letter-spacing: 0.045em;
		list-style: none;
	}

	.hero__metadata li {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.hero__metadata li::before {
		width: 0.35rem;
		height: 0.35rem;
		border: 1px solid var(--color-text-muted);
		border-radius: 50%;
		content: '';
	}

	.hero__metadata li:last-child::before {
		background: var(--color-text-muted);
	}

	@media (max-width: 58rem) {
		.hero__inner {
			grid-template-columns: 1fr;
			gap: var(--space-16);
			padding-block: var(--space-8) clamp(5rem, 14vw, 8rem);
		}

		.hero__copy {
			max-width: 46rem;
		}

		h1 {
			max-width: 13ch;
		}

		.hero__visual {
			width: min(100%, 37rem);
		}
	}

	@media (max-width: 34rem) {
		.hero__inner {
			padding-top: var(--space-6);
		}

		.hero__eyebrow {
			min-height: 4.75rem;
		}

		.hero__portrait-frame {
			width: 4.75rem;
			height: 4.75rem;
		}

		h1 {
			font-size: clamp(2.5rem, 13vw, 3.9rem);
		}

		.hero__actions {
			align-items: stretch;
		}

		.button {
			flex: 1 1 calc(50% - var(--space-3));
		}
	}
</style>
