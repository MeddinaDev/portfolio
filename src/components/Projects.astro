---
import type { ProjectsContent } from '../types/site';

interface Props {
	content: ProjectsContent;
}

const { content } = Astro.props;
const { flagship } = content;
---

<section id="proyectos" class="projects" aria-labelledby="projects-title">
	<div class="container">
		<header class="projects__header">
			<p class="projects__eyebrow">{content.eyebrow}</p>
			<h2 id="projects-title">{content.title}</h2>
			<p class="projects__introduction">{content.introduction}</p>
		</header>

		<div class="projects__showcase">
			<article class="flagship" data-spotlight>
				<div class="flagship__content">
					<div>
						<div class="flagship__meta">
							<span>{flagship.label}</span>
							<span>{flagship.category}</span>
						</div>

						<h3>{flagship.title}</h3>
						<p class="flagship__claim">{flagship.claim}</p>
						<p class="flagship__description">{flagship.description}</p>

						<ul class="stack-list" aria-label="Stack principal">
							{flagship.stack.map((technology) => <li>{technology}</li>)}
						</ul>
					</div>

					<div class="flagship__supporting">
						<ul class="feature-list" aria-label="Características técnicas">
							{flagship.features.map((feature) => <li>{feature}</li>)}
						</ul>
						<a class="project-link" href={flagship.link.href} target="_blank" rel="noopener noreferrer">
							{flagship.link.label}<span aria-hidden="true">↗</span><span class="sr-only"> (se abre en una pestaña nueva)</span>
						</a>
					</div>
				</div>

				<aside class="technical-panel" aria-label={`Detalles técnicos de ${flagship.title}`}>
					<div class="technical-panel__heading">
						<span>API / v1</span>
						<span>REST</span>
					</div>

					<code class="technical-panel__endpoint">{flagship.endpoint}</code>

					<dl class="technical-panel__grid">
						{flagship.technicalItems.map((item) => (
							<div class="technical-panel__item">
								<dt>{item.label}</dt>
								<dd>
									{item.lines.map((line) => <span>{line}</span>)}
								</dd>
							</div>
						))}
					</dl>
				</aside>
			</article>

			<div class="projects__secondary">
				{content.secondary.map((project) => (
					<article class:list={['project-card', `project-card--${project.kind}`]} data-spotlight>
						<div>
							<p class="project-card__label">{project.label}</p>
							<h3>{project.title}</h3>
							<p class="project-card__description">{project.description}</p>

							<ul class="stack-list" aria-label={`Stack de ${project.title}`}>
								{project.stack.map((technology) => <li>{technology}</li>)}
							</ul>
						</div>

						<div class="project-card__footer">
							<ul class="project-card__details" aria-label="Información técnica adicional">
								{project.details.map((detail) => <li>{detail}</li>)}
							</ul>

							<div class="project-card__links">
								{project.links.map((link) => (
									<a class="project-link" href={link.href} target="_blank" rel="noopener noreferrer">
										{link.label}<span aria-hidden="true">↗</span><span class="sr-only"> (se abre en una pestaña nueva)</span>
									</a>
								))}
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	import { setupSpotlights } from '../scripts/spotlight';

	setupSpotlights();
</script>

<style>
	.projects {
		padding-block: var(--section-space);
		border-top: 1px solid var(--color-border);
	}

	.projects__header {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.75fr);
		align-items: end;
		gap: var(--space-8) var(--space-16);
		margin-bottom: clamp(3rem, 7vw, 5rem);
	}

	.projects__eyebrow {
		display: flex;
		grid-column: 1 / -1;
		align-items: center;
		gap: var(--space-3);
		margin: 0;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.projects__eyebrow::after {
		width: 3rem;
		height: 1px;
		background: var(--color-border-strong);
		content: '';
	}

	.projects__header h2 {
		max-width: 15ch;
		margin: 0;
		font-size: clamp(2.35rem, 4.8vw, 4.7rem);
		font-weight: 520;
		letter-spacing: -0.055em;
		line-height: 1;
		text-wrap: balance;
	}

	.projects__introduction {
		max-width: 31rem;
		margin: 0 0 0.2rem;
		color: #c5c5c2;
		font-size: clamp(1rem, 1.35vw, 1.16rem);
		line-height: 1.7;
	}

	.projects__showcase {
		display: grid;
		gap: var(--space-4);
	}

	.flagship,
	.project-card {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}

	.flagship {
		--spotlight-x: 50%;
		--spotlight-y: 50%;
		--spotlight-fill-size: 30rem;
		--spotlight-fill-opacity: 12%;
		--spotlight-border-size: 15rem;
		--spotlight-border-primary-opacity: 50%;
		--spotlight-border-secondary-opacity: 20%;

		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(25rem, 0.92fr);
		min-height: 38rem;
		box-shadow: var(--shadow-soft);
	}

	[data-spotlight]::before,
	[data-spotlight]::after {
		position: absolute;
		content: '';
		opacity: 0;
		pointer-events: none;
		transition: opacity 320ms var(--ease-out);
	}

	[data-spotlight]::before {
		z-index: -1;
		inset: 0;
		background: radial-gradient(
			var(--spotlight-fill-size) circle at var(--spotlight-x) var(--spotlight-y),
			rgb(var(--color-spotlight-rgb) / var(--spotlight-fill-opacity)),
			transparent 68%
		);
	}

	[data-spotlight]::after {
		z-index: 2;
		inset: -1px;
		padding: 1px;
		border-radius: inherit;
		background: radial-gradient(
			var(--spotlight-border-size) circle at var(--spotlight-x) var(--spotlight-y),
			rgb(255 255 255 / var(--spotlight-border-primary-opacity)),
			rgb(var(--color-spotlight-rgb) / var(--spotlight-border-secondary-opacity)) 38%,
			transparent 72%
		);
		-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
	}

	[data-spotlight][data-spotlight-active]::before,
	[data-spotlight][data-spotlight-active]::after {
		opacity: 1;
	}

	.flagship__content {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-12);
		padding: clamp(2rem, 4.5vw, 4rem);
	}

	.flagship__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-6);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.flagship__meta span:first-child {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-text);
	}

	.flagship__meta span:first-child::before {
		width: 0.38rem;
		height: 0.38rem;
		border-radius: 50%;
		background: currentcolor;
		content: '';
	}

	.flagship h3 {
		max-width: 11ch;
		margin: var(--space-8) 0 0;
		font-size: clamp(2.35rem, 4.4vw, 4.15rem);
		font-weight: 540;
		letter-spacing: -0.055em;
		line-height: 0.98;
		text-wrap: balance;
	}

	.flagship__claim {
		max-width: 31rem;
		margin: var(--space-8) 0 0;
		font-size: clamp(1.08rem, 1.6vw, 1.3rem);
		line-height: 1.5;
	}

	.flagship__description {
		max-width: 34rem;
		margin: var(--space-4) 0 0;
		color: var(--color-text-muted);
		font-size: 0.94rem;
		line-height: 1.65;
	}

	.stack-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0;
		padding: 0;
		margin: var(--space-6) 0 0;
		color: #c5c5c2;
		font-family: var(--font-mono);
		font-size: 0.69rem;
		line-height: 1.5;
		list-style: none;
	}

	.stack-list li:not(:last-child)::after {
		padding-inline: 0.55rem;
		color: var(--color-text-muted);
		content: '·';
	}

	.flagship__supporting {
		display: grid;
		gap: var(--space-6);
	}

	.feature-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.feature-list li {
		padding: 0.35rem 0.55rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		line-height: 1.35;
	}

	.project-link {
		display: inline-flex;
		width: fit-content;
		min-height: 2.75rem;
		align-items: center;
		gap: var(--space-2);
		padding-block: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.035em;
		text-decoration-color: var(--color-border-strong);
		text-underline-offset: 0.32rem;
	}

	.project-link span[aria-hidden='true'] {
		transition: transform var(--duration-base) var(--ease-out);
	}

	.project-link:hover span[aria-hidden='true'],
	.project-link:focus-visible span[aria-hidden='true'] {
		transform: translate(0.12rem, -0.12rem);
	}

	.technical-panel {
		display: flex;
		min-width: 0;
		flex-direction: column;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		border-left: 1px solid var(--color-border);
		background: transparent;
	}

	.technical-panel__heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: var(--space-4);
		border-bottom: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.61rem;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.technical-panel__endpoint {
		display: block;
		padding: clamp(1.4rem, 3vw, 2rem) 0;
		overflow-wrap: anywhere;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: clamp(0.75rem, 1.25vw, 0.9rem);
		line-height: 1.55;
	}

	.technical-panel__grid {
		display: grid;
		flex: 1;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin: 0;
	}

	.technical-panel__item {
		min-width: 0;
		padding: clamp(1.25rem, 2.5vw, 1.8rem) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.technical-panel__item:nth-child(odd) {
		padding-right: var(--space-4);
		border-right: 1px solid var(--color-border);
	}

	.technical-panel__item:nth-child(even) {
		padding-left: var(--space-4);
	}

	.technical-panel__item:last-child {
		grid-column: 1 / -1;
		padding-right: 0;
		border-right: 0;
		border-bottom: 0;
	}

	.technical-panel dt {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.59rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.technical-panel dd {
		margin: var(--space-3) 0 0;
	}

	.technical-panel dd span {
		display: block;
		font-family: var(--font-mono);
		font-size: clamp(0.7rem, 1vw, 0.82rem);
		line-height: 1.6;
	}

	.technical-panel dd span + span {
		color: var(--color-text-muted);
	}

	.projects__secondary {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(19rem, 1fr);
		gap: var(--space-4);
	}

	.project-card {
		--spotlight-x: 50%;
		--spotlight-y: 50%;
		--spotlight-fill-size: 28rem;
		--spotlight-fill-opacity: 10%;
		--spotlight-border-size: 14rem;
		--spotlight-border-primary-opacity: 44%;
		--spotlight-border-secondary-opacity: 18%;

		display: flex;
		min-height: 27rem;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-12);
		padding: clamp(1.75rem, 3.8vw, 3rem);
		transition: border-color var(--duration-base) var(--ease-out), background-color var(--duration-base) var(--ease-out);
	}

	.project-card:focus-within {
		border-color: var(--color-border-strong);
	}

	@media (hover: hover) and (pointer: fine) {
		.project-card:hover .project-link {
			color: var(--color-accent-strong);
			text-decoration-color: currentcolor;
		}

		.project-card:hover .project-link span[aria-hidden='true'] {
			transform: translate(0.12rem, -0.12rem);
		}
	}

	.project-card__label {
		margin: 0;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.63rem;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.project-card h3 {
		margin: var(--space-6) 0 0;
		font-size: clamp(2rem, 3.6vw, 3.4rem);
		font-weight: 530;
		letter-spacing: -0.05em;
		line-height: 1;
		text-wrap: balance;
	}

	.project-card--rsvp h3 {
		font-size: clamp(1.85rem, 2.8vw, 2.65rem);
	}

	.project-card__description {
		max-width: 34rem;
		margin: var(--space-6) 0 0;
		color: #c5c5c2;
		font-size: 0.94rem;
		line-height: 1.65;
	}

	.project-card__footer {
		display: grid;
		gap: var(--space-6);
	}

	.project-card__details {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		padding: var(--space-4) 0 0;
		margin: 0;
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		line-height: 1.5;
		list-style: none;
	}

	.project-card__details li {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.project-card__details li::before {
		width: 0.23rem;
		height: 0.23rem;
		border-radius: 50%;
		background: currentcolor;
		content: '';
	}

	.project-card__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-6);
	}

	@media (max-width: 64rem) {
		.projects__header {
			grid-template-columns: 1fr;
		}

		.flagship {
			grid-template-columns: 1fr;
		}

		.technical-panel {
			border-top: 1px solid var(--color-border);
			border-left: 0;
		}

		.projects__secondary {
			grid-template-columns: minmax(0, 1.4fr) minmax(17rem, 1fr);
		}
	}

	@media (max-width: 46rem) {
		.projects__showcase,
		.projects__secondary {
			gap: var(--space-3);
		}

		.projects__secondary {
			grid-template-columns: 1fr;
		}

		.project-card {
			min-height: 23rem;
		}
	}

	@media (max-width: 34rem) {
		.projects__header {
			gap: var(--space-6);
		}

		.flagship__content,
		.technical-panel,
		.project-card {
			padding: 1.5rem;
		}

		.flagship h3 {
			font-size: clamp(2.15rem, 12vw, 3.2rem);
		}

		.technical-panel__grid {
			grid-template-columns: 1fr;
		}

		.technical-panel__item,
		.technical-panel__item:nth-child(odd),
		.technical-panel__item:nth-child(even),
		.technical-panel__item:last-child {
			grid-column: auto;
			padding: 1.25rem 0;
			border-right: 0;
			border-bottom: 1px solid var(--color-border);
		}

		.technical-panel__item:last-child {
			border-bottom: 0;
		}

		.project-card__links {
			gap: var(--space-3) var(--space-8);
		}

		.project-link {
			min-height: 3rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		[data-spotlight]::before,
		[data-spotlight]::after {
			display: none;
		}
	}
</style>
